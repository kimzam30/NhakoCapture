{
  "manifest_version": 3,
  "name": "NhakoCapture",
  "version": "2.1.0",
  "description": "Screenshots without leaving the tab. Freeze the page, drag a box, mark it up, then copy or save.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "offscreen",
    "downloads",
    "debugger"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "NhakoCapture",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+5",
        "mac": "Command+Shift+2"
      },
      "description": "Take a screenshot"
    }
  }
}
