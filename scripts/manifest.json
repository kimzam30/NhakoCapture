{
  "manifest_version": 3,
  "name": "NhakoCapture",
  "version": "1.0",
  "description": "A floating screenshot tool.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Nhako Screenshot"
  }
}